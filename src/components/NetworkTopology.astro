---
import { topologyNodes } from '../data/config';
import Icon from './Icon.astro';
---

<div class="topology-container" id="systems-topology">
  <div class="topology-header">
    <div class="topology-title-group">
      <div class="topology-badge">
        <span class="live-dot" aria-hidden="true"></span>
        <span class="badge-text">Interactive Systems Lab · 3D Topology</span>
      </div>
      <p class="topology-sub">Hover or drag to rotate perspective · Click any active node to inspect interface telemetry</p>
    </div>
    <div class="topology-actions">
      <button type="button" class="ctrl-btn" id="ping-nodes-btn" aria-label="Send test ICMP ping packet burst across all links">
        <Icon name="icon-pulse" size={16} />
        <span>Ping Links</span>
      </button>
      <button type="button" class="ctrl-btn" id="reset-cam-btn" aria-label="Reset perspective camera to default orientation">
        <span>Reset View</span>
      </button>
    </div>
  </div>

  <div class="canvas-viewport" id="canvas-viewport" tabindex="0" role="region" aria-label="Interactive 3D network topology visualization">
    <canvas id="topology-canvas" width="800" height="420"></canvas>
    
    <!-- Floating Node Inspector HUD -->
    <div class="node-inspector" id="node-inspector" aria-live="polite">
      <div class="hud-top">
        <span class="hud-tag" id="hud-type">GATEWAY</span>
        <span class="hud-status" id="hud-status">ACTIVE</span>
      </div>
      <h3 class="hud-title" id="hud-title">Edge Gateway / Firewall</h3>
      <div class="hud-data-grid">
        <div class="hud-row">
          <span class="hud-key">IP Address</span>
          <span class="hud-val mono" id="hud-ip">192.168.1.1</span>
        </div>
        <div class="hud-row">
          <span class="hud-key">Security Zone</span>
          <span class="hud-val" id="hud-zone">Perimeter / WAN</span>
        </div>
        <div class="hud-row">
          <span class="hud-key">Latency (RTT)</span>
          <span class="hud-val mono" id="hud-latency">1.2ms</span>
        </div>
        <div class="hud-row">
          <span class="hud-key">Ports & Protocols</span>
          <span class="hud-val mono" id="hud-ports">WAN: SFP+ · LAN: GE0/1</span>
        </div>
      </div>
      <p class="hud-desc" id="hud-desc">Hardware edge firewall executing stateful inspection, PAT address translation, and perimeter ACL filtering.</p>
      <div class="hud-footer">
        <span class="hud-prompt">Click other nodes or drag canvas to rotate</span>
      </div>
    </div>
  </div>

  <!-- Screen reader accessible fallback list -->
  <div class="sr-only">
    <h4>Network Topology Nodes:</h4>
    <ul>
      {topologyNodes.map((n) => (
        <li>
          <strong>{n.label}</strong> ({n.type}) - IP: {n.ip}, Zone: {n.zone}, Status: {n.status}. {n.description}
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .topology-container {
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
    position: relative;
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.5);
  }

  .topology-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    background: rgba(18, 24, 29, 0.7);
    border-bottom: 1px solid var(--border-subtle);
    backdrop-filter: blur(8px);
  }

  .topology-title-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .topology-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .live-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--accent-signal);
    box-shadow: 0 0 10px var(--accent-signal);
    animation: blink 2.5s infinite ease-in-out;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .badge-text {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-primary);
  }

  .topology-sub {
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin: 0;
  }

  .topology-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .ctrl-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    background: var(--surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .ctrl-btn:hover {
    color: var(--text-primary);
    border-color: var(--accent-cyan);
    background: rgba(56, 189, 248, 0.1);
  }

  .canvas-viewport {
    position: relative;
    width: 100%;
    height: 420px;
    background: radial-gradient(circle at 50% 50%, #0d1318 0%, #07090c 100%);
    overflow: hidden;
    cursor: grab;
  }

  .canvas-viewport:active {
    cursor: grabbing;
  }

  #topology-canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* HUD Node Inspector */
  .node-inspector {
    position: absolute;
    bottom: var(--space-4);
    right: var(--space-4);
    width: min(340px, calc(100% - 2rem));
    background: rgba(14, 19, 24, 0.92);
    border: 1px solid var(--border-subtle);
    border-left: 3px solid var(--accent-cyan);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    backdrop-filter: blur(12px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
    pointer-events: none;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .hud-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-2);
  }

  .hud-tag {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--accent-cyan);
    text-transform: uppercase;
  }

  .hud-status {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--accent-signal);
  }

  .hud-title {
    font-family: var(--font-sans);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: var(--space-3);
  }

  .hud-data-grid {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .hud-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
  }

  .hud-key {
    color: var(--text-muted);
  }

  .hud-val {
    color: var(--text-primary);
    font-weight: 500;
  }

  .hud-val.mono {
    font-family: var(--font-mono);
    color: var(--accent-cyan-light);
  }

  .hud-desc {
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--text-secondary);
    margin-bottom: var(--space-2);
  }

  .hud-footer {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-muted);
    font-style: italic;
  }

  @media (max-width: 48rem) {
    .topology-header {
      padding: var(--space-3);
    }
    .canvas-viewport {
      height: 380px;
    }
    .node-inspector {
      position: static;
      width: 100%;
      border-radius: 0;
      border-left: 0;
      border-top: 1px solid var(--border-subtle);
      pointer-events: auto;
    }
  }
</style>

<script>
  import { topologyNodes } from '../data/config';

  const canvas = document.getElementById('topology-canvas') as HTMLCanvasElement | null;
  const viewport = document.getElementById('canvas-viewport');
  const pingBtn = document.getElementById('ping-nodes-btn');
  const resetBtn = document.getElementById('reset-cam-btn');

  // HUD elements
  const hudType = document.getElementById('hud-type');
  const hudStatus = document.getElementById('hud-status');
  const hudTitle = document.getElementById('hud-title');
  const hudIp = document.getElementById('hud-ip');
  const hudZone = document.getElementById('hud-zone');
  const hudLatency = document.getElementById('hud-latency');
  const hudPorts = document.getElementById('hud-ports');
  const hudDesc = document.getElementById('hud-desc');

  if (canvas && viewport) {
    const ctx = canvas.getContext('2d');
    if (ctx) {
      // High DPI scaling
      function resizeCanvas() {
        if (!canvas) return;
        const rect = canvas.getBoundingClientRect();
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = rect.width * dpr;
        canvas.height = rect.height * dpr;
        ctx?.scale(dpr, dpr);
      }
      resizeCanvas();
      window.addEventListener('resize', resizeCanvas);

      // Links between nodes (Network Topology connections)
      const links = [
        { from: 'edge-gw', to: 'core-sw', label: '1000BASE-T Uplink' },
        { from: 'edge-gw', to: 'dns-resolver', label: 'WAN Tunnel' },
        { from: 'core-sw', to: 'linux-srv', label: 'VLAN 10 Trunk' },
        { from: 'core-sw', to: 'tech-ws', label: 'VLAN 20 Access' },
        { from: 'core-sw', to: 'ups-power', label: 'SNMP Telemetry' },
        { from: 'linux-srv', to: 'dns-resolver', label: 'DoT / DNS' },
      ];

      // 3D camera state
      let rotX = 0.25;
      let rotY = -0.15;
      let targetRotX = 0.25;
      let targetRotY = -0.15;
      let isDragging = false;
      let lastMouseX = 0;
      let lastMouseY = 0;
      let activeNodeIndex = 0;
      let hoveredNodeIndex = -1;

      // Packets animation
      interface Packet {
        linkIndex: number;
        progress: number;
        speed: number;
        color: string;
      }
      const packets: Packet[] = [];

      function spawnPacket(burst = false) {
        if (links.length === 0) return;
        const linkIndex = Math.floor(Math.random() * links.length);
        const speed = burst ? 0.015 + Math.random() * 0.02 : 0.006 + Math.random() * 0.008;
        const colors = ['#38bdf8', '#10b981', '#00e5ff'];
        packets.push({
          linkIndex,
          progress: 0,
          speed,
          color: colors[Math.floor(Math.random() * colors.length)],
        });
      }

      // Initial packets
      for (let i = 0; i < 5; i++) {
        spawnPacket();
      }

      function updateHUD(node: typeof topologyNodes[number]) {
        if (hudType) hudType.textContent = node.type.toUpperCase();
        if (hudStatus) hudStatus.textContent = node.status;
        if (hudTitle) hudTitle.textContent = node.label;
        if (hudIp) hudIp.textContent = node.ip;
        if (hudZone) hudZone.textContent = node.zone;
        if (hudLatency) hudLatency.textContent = node.latency;
        if (hudPorts) hudPorts.textContent = node.ports;
        if (hudDesc) hudDesc.textContent = node.description;
      }

      // Set initial HUD
      updateHUD(topologyNodes[0]);

      // Mouse drag controls for 3D orbit
      viewport.addEventListener('mousedown', (e) => {
        isDragging = true;
        lastMouseX = e.clientX;
        lastMouseY = e.clientY;
      });

      window.addEventListener('mouseup', () => {
        isDragging = false;
      });

      window.addEventListener('mousemove', (e) => {
        if (isDragging) {
          const dx = e.clientX - lastMouseX;
          const dy = e.clientY - lastMouseY;
          targetRotY += dx * 0.005;
          targetRotX += dy * 0.005;
          targetRotX = Math.max(-0.6, Math.min(0.6, targetRotX));
          lastMouseX = e.clientX;
          lastMouseY = e.clientY;
        } else {
          // Hover detection on canvas
          const rect = canvas.getBoundingClientRect();
          const mouseX = e.clientX - rect.left;
          const mouseY = e.clientY - rect.top;
          detectHover(mouseX, mouseY);
        }
      });

      // Touch controls
      viewport.addEventListener('touchstart', (e) => {
        if (e.touches.length === 1) {
          isDragging = true;
          lastMouseX = e.touches[0].clientX;
          lastMouseY = e.touches[0].clientY;
        }
      }, { passive: true });

      window.addEventListener('touchend', () => {
        isDragging = false;
      });

      window.addEventListener('touchmove', (e) => {
        if (isDragging && e.touches.length === 1) {
          const dx = e.touches[0].clientX - lastMouseX;
          const dy = e.touches[0].clientY - lastMouseY;
          targetRotY += dx * 0.006;
          targetRotX += dy * 0.006;
          targetRotX = Math.max(-0.6, Math.min(0.6, targetRotX));
          lastMouseX = e.touches[0].clientX;
          lastMouseY = e.touches[0].clientY;
        }
      }, { passive: true });

      // Click to select node
      viewport.addEventListener('click', (e) => {
        const rect = canvas.getBoundingClientRect();
        const mouseX = e.clientX - rect.left;
        const mouseY = e.clientY - rect.top;
        const clickedIndex = getIntersectedNode(mouseX, mouseY);
        if (clickedIndex !== -1) {
          activeNodeIndex = clickedIndex;
          updateHUD(topologyNodes[activeNodeIndex]);
          spawnBurst(clickedIndex);
        }
      });

      // Buttons
      pingBtn?.addEventListener('click', () => {
        for (let i = 0; i < 12; i++) {
          setTimeout(() => spawnPacket(true), i * 60);
        }
      });

      resetBtn?.addEventListener('click', () => {
        targetRotX = 0.25;
        targetRotY = -0.15;
      });

      function spawnBurst(nodeIndex: number) {
        const nodeId = topologyNodes[nodeIndex].id;
        links.forEach((l, idx) => {
          if (l.from === nodeId || l.to === nodeId) {
            packets.push({
              linkIndex: idx,
              progress: l.from === nodeId ? 0 : 1,
              speed: l.from === nodeId ? 0.02 : -0.02,
              color: '#38bdf8',
            });
          }
        });
      }

      // Projected node coordinates storage
      interface ProjectedNode {
        x: number;
        y: number;
        scale: number;
        z: number;
        origIndex: number;
      }
      let projectedNodes: ProjectedNode[] = [];

      function project3D(x: number, y: number, z: number, width: number, height: number) {
        // Rotate around Y axis
        const cosY = Math.cos(rotY);
        const sinY = Math.sin(rotY);
        const x1 = x * cosY - z * sinY;
        const z1 = z * cosY + x * sinY;

        // Rotate around X axis
        const cosX = Math.cos(rotX);
        const sinX = Math.sin(rotX);
        const y2 = y * cosX - z1 * sinX;
        const z2 = z1 * cosX + y * sinX;

        // Perspective division
        const fov = 400;
        const cameraDistance = 320;
        const scale = fov / (cameraDistance + z2);
        const screenX = width / 2 + x1 * scale * 1.5;
        const screenY = height / 2 + y2 * scale * 1.35;

        return { x: screenX, y: screenY, scale, z: z2 };
      }

      function getIntersectedNode(mx: number, my: number): number {
        for (let i = projectedNodes.length - 1; i >= 0; i--) {
          const pn = projectedNodes[i];
          const radius = 18 * pn.scale;
          const dist = Math.hypot(mx - pn.x, my - pn.y);
          if (dist <= radius + 10) {
            return pn.origIndex;
          }
        }
        return -1;
      }

      function detectHover(mx: number, my: number) {
        const hovered = getIntersectedNode(mx, my);
        if (hovered !== hoveredNodeIndex) {
          hoveredNodeIndex = hovered;
          if (viewport) {
            viewport.style.cursor = hovered !== -1 ? 'pointer' : isDragging ? 'grabbing' : 'grab';
          }
        }
      }

      // Main 60fps render loop
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      function render() {
        if (!canvas || !ctx) return;

        const rect = canvas.getBoundingClientRect();
        const width = rect.width;
        const height = rect.height;

        ctx.clearRect(0, 0, width, height);

        // Smooth camera dampening
        rotX += (targetRotX - rotX) * 0.1;
        rotY += (targetRotY - rotY) * 0.1;

        if (!prefersReduced && !isDragging) {
          // Subtle idle ambient drift
          targetRotY += 0.0003;
        }

        // Project nodes to 2D
        projectedNodes = topologyNodes.map((n, i) => {
          const p = project3D(n.x, n.y, n.z, width, height);
          return { ...p, origIndex: i };
        });

        // Background isometric grid lines
        ctx.save();
        ctx.strokeStyle = 'rgba(56, 189, 248, 0.04)';
        ctx.lineWidth = 1;
        const gridRadius = 180;
        for (let gx = -gridRadius; gx <= gridRadius; gx += 45) {
          const start = project3D(gx, 100, -gridRadius, width, height);
          const end = project3D(gx, 100, gridRadius, width, height);
          ctx.beginPath();
          ctx.moveTo(start.x, start.y);
          ctx.lineTo(end.x, end.y);
          ctx.stroke();
        }
        for (let gz = -gridRadius; gz <= gridRadius; gz += 45) {
          const start = project3D(-gridRadius, 100, gz, width, height);
          const end = project3D(gridRadius, 100, gz, width, height);
          ctx.beginPath();
          ctx.moveTo(start.x, start.y);
          ctx.lineTo(end.x, end.y);
          ctx.stroke();
        }
        ctx.restore();

        // Node lookup map
        const nodeMap = new Map<string, ProjectedNode>();
        projectedNodes.forEach((pn) => {
          nodeMap.set(topologyNodes[pn.origIndex].id, pn);
        });

        // Draw Links
        links.forEach((link) => {
          const fromNode = nodeMap.get(link.from);
          const toNode = nodeMap.get(link.to);
          if (!fromNode || !toNode) return;

          ctx.save();
          const isLinkedToActive =
            topologyNodes[activeNodeIndex]?.id === link.from ||
            topologyNodes[activeNodeIndex]?.id === link.to;

          ctx.strokeStyle = isLinkedToActive
            ? 'rgba(56, 189, 248, 0.55)'
            : 'rgba(255, 255, 255, 0.12)';
          ctx.lineWidth = isLinkedToActive ? 2 : 1;
          ctx.setLineDash(isLinkedToActive ? [] : [4, 4]);

          ctx.beginPath();
          ctx.moveTo(fromNode.x, fromNode.y);
          ctx.lineTo(toNode.x, toNode.y);
          ctx.stroke();
          ctx.restore();
        });

        // Update and draw Packets
        if (!prefersReduced) {
          for (let i = packets.length - 1; i >= 0; i--) {
            const p = packets[i];
            p.progress += p.speed;

            if (p.progress >= 1 || p.progress <= 0) {
              packets.splice(i, 1);
              if (Math.random() > 0.4) spawnPacket();
              continue;
            }

            const link = links[p.linkIndex];
            if (!link) continue;
            const fromNode = nodeMap.get(link.from);
            const toNode = nodeMap.get(link.to);
            if (!fromNode || !toNode) continue;

            const px = fromNode.x + (toNode.x - fromNode.x) * p.progress;
            const py = fromNode.y + (toNode.y - fromNode.y) * p.progress;

            ctx.save();
            ctx.fillStyle = p.color;
            ctx.shadowColor = p.color;
            ctx.shadowBlur = 8;
            ctx.beginPath();
            ctx.arc(px, py, 3, 0, Math.PI * 2);
            ctx.fill();
            ctx.restore();
          }
        }

        // Draw Nodes sorted by depth (back to front)
        const sortedNodes = [...projectedNodes].sort((a, b) => b.z - a.z);

        sortedNodes.forEach((pn) => {
          const nodeData = topologyNodes[pn.origIndex];
          const isActive = pn.origIndex === activeNodeIndex;
          const isHovered = pn.origIndex === hoveredNodeIndex;
          const baseRadius = 14 * pn.scale;

          ctx.save();

          // Outer aura ring if active or hovered
          if (isActive || isHovered) {
            ctx.beginPath();
            ctx.arc(pn.x, pn.y, baseRadius + 7, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(56, 189, 248, 0.15)';
            ctx.fill();
            ctx.strokeStyle = isActive ? '#38bdf8' : 'rgba(56, 189, 248, 0.6)';
            ctx.lineWidth = 1.5;
            ctx.stroke();
          }

          // Node body circle
          ctx.beginPath();
          ctx.arc(pn.x, pn.y, baseRadius, 0, Math.PI * 2);
          ctx.fillStyle = isActive ? '#0e2433' : '#141c22';
          ctx.fill();
          ctx.strokeStyle = isActive
            ? '#38bdf8'
            : nodeData.type === 'security'
            ? '#10b981'
            : 'rgba(255, 255, 255, 0.25)';
          ctx.lineWidth = isActive ? 2 : 1.2;
          ctx.stroke();

          // Inner LED beacon
          ctx.beginPath();
          ctx.arc(pn.x, pn.y, 4 * pn.scale, 0, Math.PI * 2);
          ctx.fillStyle = nodeData.type === 'security'
            ? '#10b981'
            : isActive
            ? '#38bdf8'
            : '#94a3b8';
          ctx.shadowColor = ctx.fillStyle;
          ctx.shadowBlur = isActive ? 10 : 4;
          ctx.fill();
          ctx.restore();

          // Label text below node
          ctx.save();
          ctx.font = `${Math.max(10, Math.round(11 * pn.scale))}px var(--font-mono, monospace)`;
          ctx.textAlign = 'center';
          ctx.textBaseline = 'top';

          // Background pill for label legibility
          const text = nodeData.label;
          const textMetrics = ctx.measureText(text);
          const textW = textMetrics.width + 10;
          const textH = 16;
          const textY = pn.y + baseRadius + 4;

          ctx.fillStyle = 'rgba(10, 14, 18, 0.85)';
          ctx.fillRect(pn.x - textW / 2, textY, textW, textH);
          ctx.strokeStyle = isActive ? 'rgba(56, 189, 248, 0.4)' : 'rgba(255, 255, 255, 0.08)';
          ctx.strokeRect(pn.x - textW / 2, textY, textW, textH);

          ctx.fillStyle = isActive ? '#f1f5f9' : '#94a3b8';
          ctx.fillText(text, pn.x, textY + 2);
          ctx.restore();
        });

        requestAnimationFrame(render);
      }

      requestAnimationFrame(render);
    }
  }
</script>
