---
import type { IconName } from '../data/icons';
interface Props { name: IconName; size?: 16 | 20 | 24 | 32 | 48; label?: string }
const { name, size = 24, label } = Astro.props;
const files = import.meta.glob<string>('../icons/*.svg', { query: '?raw', import: 'default', eager: true });
const inner = files[`../icons/${name}.svg`];
if (inner === undefined) throw new Error(`Icon file missing: ${name}`);
---
<svg class="icon" style={`--icon-size:${size / 16}rem`} viewBox="0 0 24 24" fill="none" stroke="currentColor"
  stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
  role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'} set:html={inner} />
